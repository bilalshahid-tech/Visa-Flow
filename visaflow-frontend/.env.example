# VisaFlow Frontend Environment Variables

# Option 1: Direct Backend API URL (Used on Vercel deployment & browser client)
# Set this in Vercel Settings -> Environment Variables to your Render backend URL:
# NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Option 2: Server-side rewrite URL (Used in Next.js rewrites)
# BACKEND_URL=https://your-backend-service.onrender.com
